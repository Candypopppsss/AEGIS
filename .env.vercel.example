# For Spring Boot + Aiven MySQL, set this HTTPS backend origin.
# When set, Turso and SESSION_SECRET are unused by the Vercel API.
SPRING_API_URL=
# Otherwise configure the original Turso backend below.
TURSO_DATABASE_URL=libsql://your-database.turso.io
TURSO_AUTH_TOKEN=replace-with-your-database-token
SESSION_SECRET=replace-with-a-random-secret-at-least-32-bytes
# Only needed for a custom domain; Vercel URLs are allowed automatically.
FRONTEND_ORIGIN=
