# Copy to .env and replace the public address before exposing the app.
# Docker's host must be reachable at this address; Docker does not assign a public IP.
WEB_BIND=0.0.0.0
WEB_PORT=8081
FRONTEND_ORIGIN=http://YOUR_PUBLIC_IP:8081,http://localhost:8081,http://127.0.0.1:8081
# Optional: test through the public address instead of the local published port.
# DEPLOY_URL=http://YOUR_PUBLIC_IP:8081
